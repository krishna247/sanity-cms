# Headers applied by Cloudflare Pages.
# Rules later in the file override earlier ones for the same header.
# Copied into dist/ by the package.json `postbuild` script.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  # index.html (and all non-hashed entry docs) must always revalidate, or a
  # stale-cached index.html keeps referencing old immutable /static bundles —
  # which is how editors got pinned to a dead Presentation preview URL.
  Cache-Control: no-cache

# Sanity Studio hashed bundles — content-addressed, safe to cache forever.
# Later rule wins, so these stay immutable despite the no-cache above.
/static/*
  Cache-Control: public, max-age=31536000, immutable
