# Headers applied by Cloudflare Pages.
# Rules later in the file override earlier ones for the same header.
# Copied into dist/ by the package.json `postbuild` script.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block

# Sanity Studio hashed bundles — content-addressed, safe to cache forever
/static/*
  Cache-Control: public, max-age=31536000, immutable
