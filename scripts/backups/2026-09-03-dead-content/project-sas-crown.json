    {
      "_key": "k295",
      "_type": "proseBlock",
      "body": [
        {
          "_key": "k289",
          "_type": "block",
          "children": [
            {
              "_key": "k290",
              "_type": "span",
              "marks": [],
              "text": "SAS Crown — South India's tallest residential tower — rises 244 metres above Kokapet, the city's most rapidly maturing residential corridor. G + 59 floors set across 4.5 acres of lush greenery, with eighty percent of the site held as open and landscaped space."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "k291",
          "_type": "block",
          "children": [
            {
              "_key": "k292",
              "_type": "span",
              "marks": [],
              "text": "Each home is a 4 BHK with an office room, an entertainment room and a maid room, ranging from 6,565 to 8,811 sq ft, with east-and-west orientations that bring through-light and ventilation. Italian marble flooring; thirteen-foot ceilings; private sky villas occupying entire upper floors. The Sky Club, at this height, the first of its kind in India, sits within Tower 2."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "k293",
          "_type": "block",
          "children": [
            {
              "_key": "k294",
              "_type": "span",
              "marks": [],
              "text": "Designed by Simon Naf, Aedas. Design collaborators for landmark projects across Asia."
            }
          ],
          "markDefs": [],
          "style": "normal"
        }
      ],
      "head": {
        "eyebrow": "The Vision",
        "heading": "Luxury apartments in <em>Kokapet</em>, Hyderabad."
      }
    },
